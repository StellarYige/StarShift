{
  "name": "starshift",
  "version": "0.1.1",
  "description": "星易 StarShift · 只是转个文件，不必开个会员。",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "fixtures": "node scripts/create-fixtures.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run test:matrix",
    "test:matrix": "playwright test --config playwright.matrix.config.ts",
    "measure:docx": "node scripts/measure-docx.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellarYige/StarShift.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/StellarYige/StarShift/issues"
  },
  "homepage": "https://stellaryige.github.io/StarShift/",
  "dependencies": {
    "coi-serviceworker": "0.1.7",
    "fflate": "0.8.3",
    "lucide-react": "1.45.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zetajs": "1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "docx": "9.7.1",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "private": true,
  "license": "MIT"
}
